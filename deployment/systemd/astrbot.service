[Unit]
Description=AstrBot QQ assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/personal-ai/astrbot
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/personal-ai/astrbot/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ASTRBOT_DASHBOARD_HOST=127.0.0.1
Environment=ASTRBOT_DASHBOARD_PORT=6185
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/personal-ai/astrbot/secrets/codex-bridge.env
ExecStart=/home/ubuntu/personal-ai/astrbot/bin/astrbot run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/personal-ai/astrbot /home/ubuntu/personal-ai/agent-workspace
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryHigh=1800M
MemoryMax=2300M
TasksMax=256

[Install]
WantedBy=multi-user.target
